# ---- Bazel ----------------------------------------------------------------
# Convenience symlinks Bazel creates in the workspace root: bazel-<workspace>,
# bazel-bin, bazel-out, bazel-testlogs.
/bazel-*

# Machine-local Bazel settings, imported by .bazelrc via try-import.
/user.bazelrc

# MODULE.bazel.lock is intentionally NOT ignored: it pins the resolved dependency
# graph and belongs in version control.

# ---- Clang tooling ----------------------------------------------------------
# Generated from the Bazel build; regenerate rather than commit.
/compile_commands.json
/.cache/
/.clangd/
.clang-tidy-cache/

# ---- Editors and OS ---------------------------------------------------------
/.vscode/
/.idea/
*.swp
*.swo
*~
.DS_Store

# ---- Python (pre-commit virtualenvs, if created in-tree) --------------------
/.venv/
__pycache__/

# HTML reports written by //examples:lqr_experiments when run with its default output
# directory. The committed copies of these live in docs/screenshots as images.
/lqr_reports/

# The HTML report written by //examples:double_inverted_pendulum with its default output
# directory.
/double_inverted_pendulum_report/
