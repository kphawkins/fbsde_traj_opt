        "//fbsde_traj_opt/sampling:l1_exploratory_control",
        "//fbsde_traj_opt/utils:result",
        "@eigen",
    ],
)

cc_test(
    name = "epsilon_greedy_l1_control_sampler_test",
    size = "small",
    srcs = ["epsilon_greedy_l1_control_sampler.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":epsilon_greedy_l1_control_sampler",
