"""The FBRRT method: RRT-style branched forward sampling, a Taylor-noiseless SGD backward pass, and
path-integral erosion, each a swappable component the solver composes.

Follows the layout convention described in the README: headers, sources, and unit tests live
together, and a test for `foo.cpp` is named `foo.test.cpp`.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FBSDE_COPTS", "FBSDE_TEST_COPTS")

package(
    default_visibility = ["//visibility:public"],
    # Compile every header standalone to catch missing includes.
    features = ["parse_headers"],
)

cc_library(
    name = "fbrrt_particle_set",
    hdrs = ["fbrrt_particle_set.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "//fbsde_traj_opt/utils:result",
        "@eigen",
    ],
)

cc_test(
    name = "fbrrt_particle_set_test",
    size = "small",
    srcs = ["fbrrt_particle_set.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":fbrrt_particle_set",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "brute_force_nearest_neighbor",
    hdrs = ["brute_force_nearest_neighbor.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "//fbsde_traj_opt/utils:result",
        "@eigen",
    ],
)

cc_test(
    name = "brute_force_nearest_neighbor_test",
    size = "small",
    srcs = ["brute_force_nearest_neighbor.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":brute_force_nearest_neighbor",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "rrt_expansion_selector",
    hdrs = ["rrt_expansion_selector.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        ":brute_force_nearest_neighbor",
        "//fbsde_traj_opt/sampling:counter_based_normal_sampler",
        "//fbsde_traj_opt/sampling:l1_exploratory_control",
        "//fbsde_traj_opt/utils:result",
        "@eigen",
    ],
)

cc_test(
    name = "rrt_expansion_selector_test",
    size = "small",
    srcs = ["rrt_expansion_selector.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":brute_force_nearest_neighbor",
        ":rrt_expansion_selector",
        "//fbsde_traj_opt/sampling:counter_based_normal_sampler",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
