"""Drift and diffusion terms for the forward SDE, and discretization of continuous-time linear dynamics.

Follows the layout convention described in the README: headers, sources, and unit tests live
together, and a test for `foo.cpp` is named `foo.test.cpp`.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FBSDE_COPTS", "FBSDE_TEST_COPTS")

package(
    default_visibility = ["//visibility:public"],
    # Compile every header standalone to catch missing includes.
    features = ["parse_headers"],
)

cc_library(
    name = "const_diagonal_sde_diffusion_term",
    hdrs = ["const_diagonal_sde_diffusion_term.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "//fbsde_traj_opt/utils:result",
        "@eigen",
    ],
)

cc_test(
    name = "const_diagonal_sde_diffusion_term_test",
    size = "small",
    srcs = ["const_diagonal_sde_diffusion_term.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":const_diagonal_sde_diffusion_term",
        "//fbsde_traj_opt/sde:sde_term_concepts",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "const_linear_sde_state_drift_term",
    hdrs = ["const_linear_sde_state_drift_term.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "@eigen",
    ],
)

cc_test(
    name = "const_linear_sde_state_drift_term_test",
    size = "small",
    srcs = ["const_linear_sde_state_drift_term.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":const_linear_sde_state_drift_term",
        "//fbsde_traj_opt/sde:sde_term_concepts",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "const_linear_sde_control_drift_mat_term",
    hdrs = ["const_linear_sde_control_drift_mat_term.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "@eigen",
    ],
)

cc_test(
    name = "const_linear_sde_control_drift_mat_term_test",
    size = "small",
    srcs = ["const_linear_sde_control_drift_mat_term.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":const_linear_sde_control_drift_mat_term",
        "//fbsde_traj_opt/sde:sde_term_concepts",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "zero_order_hold_discretization",
    hdrs = ["zero_order_hold_discretization.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "//fbsde_traj_opt/utils:result",
        "@eigen",
    ],
)

cc_test(
    name = "zero_order_hold_discretization_test",
    size = "small",
    srcs = ["zero_order_hold_discretization.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":zero_order_hold_discretization",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
