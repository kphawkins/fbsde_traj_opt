"""Normal distributions and the counter-based sampler that draws reproducible noise for trajectory batches.

Follows the layout convention described in the README: headers, sources, and unit tests live
together, and a test for `foo.cpp` is named `foo.test.cpp`.
"""

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "FBSDE_COPTS", "FBSDE_TEST_COPTS")

package(
    default_visibility = ["//visibility:public"],
    # Compile every header standalone to catch missing includes.
    features = ["parse_headers"],
)

cc_library(
    name = "normal_distribution_concepts",
    hdrs = ["normal_distribution_concepts.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "//fbsde_traj_opt/utils:eigen_concepts",
    ],
)

cc_test(
    name = "normal_distribution_concepts_test",
    size = "small",
    srcs = ["normal_distribution_concepts.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":normal_distribution_concepts",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "diagonal_covariance_normal_distribution",
    hdrs = ["diagonal_covariance_normal_distribution.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "//fbsde_traj_opt/utils:result",
        "@eigen",
    ],
)

cc_test(
    name = "diagonal_covariance_normal_distribution_test",
    size = "small",
    srcs = ["diagonal_covariance_normal_distribution.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":diagonal_covariance_normal_distribution",
        ":normal_distribution_concepts",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "counter_based_normal_sampler",
    hdrs = ["counter_based_normal_sampler.hpp"],
    copts = FBSDE_COPTS,
    deps = [
        "//fbsde_traj_opt/utils:eigen_concepts",
        "@eigen",
    ],
)

cc_test(
    name = "counter_based_normal_sampler_test",
    size = "small",
    srcs = ["counter_based_normal_sampler.test.cpp"],
    copts = FBSDE_TEST_COPTS,
    deps = [
        ":counter_based_normal_sampler",
        "@eigen",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
