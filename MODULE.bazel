"""Bazel module definition for fbsde_traj_opt.

Trajectory optimization via forward-backward stochastic differential equations.
"""

module(
    name = "fbsde_traj_opt",
    version = "0.0.1",
    compatibility_level = 1,
)

# Bazel 9 removed all cc_* rules from the core binary; they are only available from rules_cc.
bazel_dep(name = "rules_cc", version = "0.2.22")

# Matrix and linear-algebra types. Header-only; the only target is @eigen//:eigen.
bazel_dep(name = "eigen", version = "5.0.0")

# Test-only. GoogleTest bundles GoogleMock inside @googletest//:gtest; there is no :gmock target.
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)
